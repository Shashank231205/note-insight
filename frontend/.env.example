# Frontend configuration — copy to frontend/.env.local for development.
#
# Every VITE_ variable is compiled into the browser bundle and is therefore
# public. The Firebase web API key is safe here: it identifies the project, it
# does not authorize anything. The Gemini key is NOT here and never will be —
# it is a bearer credential and lives only on the server.

VITE_API_BASE_URL=http://localhost:8000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
