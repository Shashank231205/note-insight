# Backend configuration — copy to backend/.env for local development.
# Never commit the populated file.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_VERSION=1.0.0

# Comma-separated allowlist. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Firebase ---------------------------------------------------------------
FIREBASE_PROJECT_ID=note-insight-local
# Full service-account JSON as a single-line string. Leave empty when using
# the emulator (see README) — the Admin SDK then runs without credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set only for local emulator work.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# LLM --------------------------------------------------------------------
# "mock" for all development; "gemini" only at the integration stage.
LLM_PROVIDER=mock
# Comma-separated. First is primary, the rest are fallbacks used on quota
# or auth failure.
GEMINI_API_KEYS=
GEMINI_MODEL_ID=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=4096
PROMPT_VERSION=v2

# Limits -----------------------------------------------------------------
ANALYSIS_RATE_LIMIT_PER_HOUR=10
ANALYSIS_RATE_LIMIT_BURST=3
NOTE_MIN_WORDS=100
NOTE_MAX_WORDS=3000
NOTE_MAX_CHARS=40000
MAX_REQUEST_BODY_BYTES=262144
