rules_version = '2';

// Note Insight stores no data reachable by a client SDK.
//
// The browser holds the Firebase Auth SDK only; every read and write goes
// through the FastAPI backend using the Admin SDK, which bypasses these rules.
// Authorization is implemented once, in Python, where it is unit-tested —
// rather than twice, here and there, where the two copies must agree forever.
//
// This file is therefore a backstop: if a client SDK is ever added by mistake,
// it reaches nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
